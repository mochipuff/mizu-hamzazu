# Public https URL of the site, no trailing slash. Needed for og:image, canonical and sitemap.xml.
# On Vercel it falls back to the project production domain when this is empty.
VITE_SITE_URL=https://your-domain.tld

# Server only, read by api/index.ts. Never give these a VITE_ prefix: Vite publishes every VITE_ variable in the browser bundle.
# On Vercel add them in Project Settings, Environment Variables (mark both Sensitive). Locally, copy this file to .env.local.
SUPABASE_URL=https://.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Server only, optional. Extra sites (comma separated, with https://) allowed to call /api/*, for example a www alias. This site, Vercel preview URLs and localhost are always allowed outside production.
ALLOWED_ORIGINS=

# Server only, read by api/index.ts. YouTube Data API v3 key. Used only by the daily cron that fills the `videos` table.
YOUTUBE_API_KEY=

# Server only. At least 32 random characters.
CRON_SECRET=