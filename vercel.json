{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api" }],
  "functions": { "api/index.ts": { "maxDuration": 30 } },
  "crons": [{ "path": "/api/videos/sync/", "schedule": "0 3 * * *" }],
  "redirects": [
    {
      "source": "/api/:path*",
      "has": [{ "type": "header", "key": "Sec-Fetch-Dest", "value": "(document|iframe|frame|fencedframe|embed|object)" }],
      "destination": "/forbidden/",
      "permanent": false
    },
    { "source": "/milestones/:path*", "destination": "/", "permanent": true },
    { "source": "/:locale(en|jp|id)/milestones/:path*", "destination": "/:locale/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(emotes|hero|membership)/(.+\\.webp)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=31536000" }]
    },
    {
      "source": "/(favicon.ico|favicon.svg|og-image.webp)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=31536000" }]
    },
    {
      "source": "/(llms.txt|robots.txt|redirect.js|sitemap.xml|sitemap-images.xml)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com https://*.supabase.co https://pbs.twimg.com; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
